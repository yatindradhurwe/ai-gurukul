# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://gurukul:gurukul@localhost:5432/gurukul
# Use a long random value in every non-dev environment
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173

# --- AI provider: "mock" (offline, deterministic) or "anthropic" ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Avatar provider: "mock" until a licensed vendor adapter is added ---
AVATAR_PROVIDER=mock

# --- Payments: "mock" provider; webhook HMAC secret ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
