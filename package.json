{
  "name": "ai-gurukul",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "worker": "npm run worker -w apps/api",
    "start": "node apps/api/dist/database/seeds/seed.js && node apps/api/dist/server.js",
    "setup:demo": "node apps/api/dist/database/seeds/demo-accounts.js"
  },
  "engines": {
    "node": ">=20"
  }
}
